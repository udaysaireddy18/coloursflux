# ColoursFlux — environment reference
#
# The public site is a static app and does NOT read this file at runtime.
# The browser configuration lives in assets/js/env.js (copy from
# assets/js/env.example.js). Only the PUBLIC anon/publishable key belongs there.
#
# These variables exist so CI or hosting scripts can mirror the same values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Never add SUPABASE_SERVICE_ROLE_KEY, database passwords or any other secret
# to this project. Nothing in the frontend is allowed to hold one.
